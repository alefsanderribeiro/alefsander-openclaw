# ============================================================
# OpenClaw Custom — Arquivo de Variáveis de Ambiente (.env)
# ============================================================
#
# COMO USAR:
#   1. Copie este arquivo para .env:
#        cp .env.example .env
#   2. Edite o .env com seus valores:
#        nano .env
#   3. Após alterar qualquer variável, recrie os containers:
#        docker compose down && docker compose up -d
#
# REGRAS IMPORTANTES:
#   - Nunca commit o arquivo .env no git (já está no .gitignore)
#   - Preencha APENAS as variáveis que você vai usar
#   - Valores vazios ("") são ignorados
#   - Não use aspas ao redor dos valores
# ============================================================

# ============================================================
# NOME DO PROJETO
# ============================================================
COMPOSE_PROJECT_NAME=openclaw

# ============================================================
# IMAGEM DOCKER
# ============================================================
OPENCLAW_IMAGE=ghcr.io/alefsanderribeiro/alefsander-openclaw:latest

# ============================================================
# CAMINHOS DE DIRETÓRIOS (no HOST)
# ============================================================
OPENCLAW_CONFIG_DIR=$HOME/.openclaw
OPENCLAW_WORKSPACE_DIR=$HOME/.openclaw/workspace

# Pasta de documentos/projetos do host montada no container
# (ex: MEGA Drive sincronizado). Vazio = não monta.
# Formato: /caminho/no/host:/caminho/no/container:rw
OPENCLAW_DOCS_MOUNT=$HOME/Documentos:/home/node/Documentos:rw

# ============================================================
# PORTAS
# ============================================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# ============================================================
# BIND MODE — lan | loopback | tailnet | custom
# ============================================================
OPENCLAW_GATEWAY_BIND=lan

# ============================================================
# AUTH — Senha/Token do Gateway
# ============================================================
# Modo "password" (senha) ou "token".
# Para gerar um token seguro: openssl rand -hex 32
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_GATEWAY_TOKEN=

# ============================================================
# REDE DOCKER EXTERNA — integrações self-hosted
# ============================================================
# Conecta o container a uma rede Docker externa para acessar
# serviços self-hosted pelo nome (SearXNG, Home Assistant,
# Vaultwarden, Uptime Kuma, Netdata...).
# Deixe vazio se não precisar.
#   docker network create vaultwarden_tailscale-net
OPENCLAW_NETWORK=vaultwarden_tailscale-net

# ============================================================
# MODEL PROVIDERS
# ============================================================
# Modelos principais (opencode-go) e free (opencode):
#   https://opencode.ai — painel com chaves API
OPENCODE_API_KEY=
OPENCODE_GO_API_KEY=

# Google Gemini (fallback, mídia, busca)
GEMINI_API_KEY=

# Providers clássicos (opcionais)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ============================================================
# CANAIS DE MENSAGEM
# ============================================================
# Telegram: fale com @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Seu ID numérico no Telegram (dono do gateway)
TELEGRAM_OWNER_ID=

# WhatsApp: usa QR code — não precisa de token.
# Rode: docker compose run --rm cli channels login
WHATSAPP_OWNER_NUMBER=

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SIGNAL_BOT_TOKEN=

# ============================================================
# FERRAMENTAS E SKILLS
# ============================================================
# GitHub CLI (skill github) — Personal Access Token
#   https://github.com/settings/tokens
GH_TOKEN=

# SearXNG self-hosted (busca web privada)
# Dentro da rede docker: http://searxng:8080
# Público: https://search.seu-dominio.com
SEARXNG_BASE_URL=http://searxng:8080

# Home Assistant (skill home-assistant-rest)
# Dentro da rede docker: http://homeassistant:8123
HOME_ASSISTANT_URL=http://homeassistant:8123
HOME_ASSISTANT_TOKEN=

# Google Workspace (plugin openclaw-google-workspace)
# Credenciais OAuth (Desktop Client) — veja docs/README
GOOGLE_CREDENTIALS_PATH=$HOME/.openclaw/secrets/gmail-credentials.json
GOOGLE_TOKEN_PATH=$HOME/.openclaw/secrets/gmail-tokens.json

# Brave / Firecrawl / Perplexity (opcionais)
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=

# ============================================================
# VOZ E MÍDIA
# ============================================================
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ============================================================
# GPU NVIDIA — Aceleração para Whisper
# ============================================================
# Requer nvidia-container-toolkit no host. Sem GPU, roda em CPU.
# Modelo Whisper: tiny | base | small | medium | large
WHISPER_MODEL=base

# ============================================================
# SHELL ENVIRONMENT
# ============================================================
OPENCLAW_LOAD_SHELL_ENV=0
OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# ============================================================
# MOUNTS EXTRAS — diretórios adicionais do host
# ============================================================
# Formato: host_path:container_path[:rw|ro] (vírgula separa vários)
OPENCLAW_EXTRA_MOUNTS=

# ============================================================
# VOLUME NOMEADO — persistência completa de /home/node
# ============================================================
OPENCLAW_HOME_VOLUME=

# ============================================================
# OBSERVABILIDADE — OpenTelemetry / Prometheus
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gateway
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ============================================================
# PACOTES APT EXTRAS — instalados no build
# ============================================================
OPENCLAW_DOCKER_APT_PACKAGES=

# ============================================================
# SANDBOX / SKIPS / DOCKER SOCKET / BONJOUR
# ============================================================
OPENCLAW_SANDBOX=
OPENCLAW_SKIP_ONBOARDING=
OPENCLAW_SKIP_CANVAS_HOST=
OPENCLAW_SKIP_GMAIL_WATCHER=
OPENCLAW_DOCKER_SOCKET=
OPENCLAW_DISABLE_BONJOUR=1
