// ============================================================
// OpenClaw — Configuração de Exemplo (openclaw.json)
// ============================================================
// Espelha a configuração REAL usada no setup de referência
// (agentes main/dev/extrator/orion, plugins, skills, canais).
//
// COMO USAR:
//   1. Copie este arquivo para ~/.openclaw/openclaw.json:
//        cp openclaw.json.example ~/.openclaw/openclaw.json
//   2. Substitua os ${VAR} pelos seus valores (ou exporte as
//      variáveis de ambiente no .env — o OpenClaw resolve).
//   3. Valide: openclaw doctor --fix
//
// FORMATO: JSON5 (permite comentários e trailing commas)
// SEGURANÇA: NUNCA coloque chaves reais aqui. Use ${VAR}.
// ============================================================

{
  // ============================================================
  // GATEWAY — Servidor principal
  // ============================================================
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      // "password" (senha) ou "token" (token longo)
      "mode": "password",
      // Senha do Control UI / API — defina uma forte
      "password": "${OPENCLAW_GATEWAY_PASSWORD:-mude-esta-senha}"
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true,
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789",
        "https://openclaw.SEU_DOMINIO.com"
      ]
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },

  // ============================================================
  // AGENTS — Agentes de IA
  // ============================================================
  "agents": {
    "defaults": {
      "model": {
        "primary": "opencode-go/deepseek-v4-flash",
        "fallbacks": [
          "opencode/deepseek-v4-flash-free"
        ]
      },
      "bootstrapMaxChars": 50000,
      "bootstrapTotalMaxChars": 300000,
      "contextInjection": "always",
      "workspace": "/home/node/.openclaw/workspace",
      // Modelos com apelidos bonitos no seletor
      "models": {
        "opencode-go/deepseek-v4-flash": { "alias": "DeepSeek V4 Flash" },
        "opencode-go/deepseek-v4-pro": { "alias": "DeepSeek V4 Pro" },
        "opencode-go/glm-5.2": { "alias": "GLM 5.2" },
        "opencode-go/glm-5.1": { "alias": "GLM 5.1" },
        "opencode-go/kimi-k2.7-code": { "alias": "Kimi K2.7 Code" },
        "opencode-go/kimi-k2.6": { "alias": "Kimi K2.6" },
        "opencode-go/mimo-v2.5": { "alias": "MiMo V2.5" },
        "opencode-go/mimo-v2.5-pro": { "alias": "MiMo V2.5 Pro" },
        "opencode-go/mimo-v2-omni": { "alias": "MiMo V2 Omni" },
        "opencode-go/mimo-v2-pro": { "alias": "MiMo V2 Pro" },
        "opencode-go/minimax-m3": { "alias": "MiniMax M3" },
        "opencode-go/minimax-m2.7": { "alias": "MiniMax M2.7" },
        "opencode-go/qwen3.7-max": { "alias": "Qwen3.7 Max" },
        "opencode-go/qwen3.7-plus": { "alias": "Qwen3.7 Plus" },
        "opencode-go/qwen3.6-plus": { "alias": "Qwen3.6 Plus" },
        "opencode-go/qwen3.5-plus": { "alias": "Qwen3.5 Plus" },
        "opencode-go/hy3-preview": { "alias": "HY3 Preview" },
        "opencode/deepseek-v4-flash-free": { "alias": "DeepSeek V4 Flash Free" },
        "opencode/mimo-v2.5-free": { "alias": "MiMo V2.5 Free" },
        "opencode/north-mini-code-free": { "alias": "North Mini Code Free" },
        "opencode/nemotron-3-ultra-free": { "alias": "Nemotron 3 Ultra Free" },
        "opencode/big-pickle": { "alias": "Big Pickle" },
        "opencode/hy3-free": { "alias": "HY3 Free" },
        "opencode/claude-opus-4-6": { "alias": "Opus" }
      },
      "memorySearch": {
        "provider": "none",
        "model": ""
      },
      "compaction": {
        "recentTurnsPreserve": 12,
        "maxHistoryShare": 0.9,
        "reserveTokens": 4000,
        "notifyUser": true,
        "truncateAfterCompaction": false
      }
    },

    // ============================================================
    // AGENTES ESPECÍFICOS
    // Os arquivos de identidade/instruções ficam em agents/<id>/workspace/
    // (veja a pasta agents/ deste repositório)
    // ============================================================
    "list": [
      {
        "id": "main",
        // Skills ativas no agente principal
        "skills": [
          "browser-automation",
          "clawhub",
          "github",
          "google-workspace-assistant",
          "healthcheck",
          "home-assistant-rest",
          "meme-maker",
          "monitorador-de-servidor",
          "openai-whisper",
          "python-debugpy",
          "skill-creator",
          "spike",
          "taskflow",
          "taskflow-inbox-triage",
          "tmux",
          "video-frames",
          "weather"
        ],
        "subagents": {
          "allowAgents": [
            "extrator",
            "dev",
            "orion"
          ]
        },
        "tools": {
          "profile": "full"
        }
      },
      {
        "id": "dev",
        "name": "Dev",
        "workspace": "/home/node/.openclaw/agents/dev/workspace",
        "model": {
          "primary": "opencode-go/deepseek-v4-flash",
          "fallbacks": ["opencode/deepseek-v4-flash-free"]
        },
        "skills": [],
        "tools": {
          "profile": "full"
        }
      },
      {
        "id": "extrator",
        "name": "Extrator de Produtos",
        "workspace": "/home/node/.openclaw/agents/extrator/workspace",
        "model": {
          "primary": "opencode-go/deepseek-v4-flash",
          "fallbacks": ["opencode/deepseek-v4-flash-free"]
        },
        "skills": [],
        "tools": {
          "profile": "full",
          "allow": [
            "web_fetch",
            "web_search",
            "exec",
            "read",
            "write",
            "edit",
            "memory_search",
            "memory_get",
            "image",
            "pdf",
            "message"
          ]
        }
      },
      {
        "id": "orion",
        "name": "Orion",
        "workspace": "/home/node/.openclaw/agents/orion/workspace",
        "model": {
          "primary": "opencode-go/deepseek-v4-flash",
          "fallbacks": ["opencode/deepseek-v4-flash-free"]
        },
        "skills": [],
        "tools": {
          "profile": "full",
          "allow": [
            "exec",
            "web_search",
            "web_fetch",
            "read",
            "write",
            "edit",
            "memory_search",
            "memory_get",
            "image",
            "pdf",
            "message"
          ]
        }
      }
    ]
  },

  // ============================================================
  // MODELS — Providers de IA
  // ============================================================
  // Neste setup: opencode (modelos free) e opencode-go (modelos
  // principais), além de google (Gemini p/ mídia e fallback).
  // ============================================================
  "models": {
    "mode": "merge",
    "providers": {
      "google": {
        "apiKey": "${GEMINI_API_KEY}"
      },
      "opencode": {
        "apiKey": "${OPENCODE_API_KEY}",
        "baseUrl": "https://opencode.ai/zen/v1",
        "models": [
          { "id": "deepseek-v4-flash-free", "name": "DeepSeek V4 Flash Free", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "mimo-v2.5-free", "name": "MiMo V2.5 Free", "contextWindow": 200000, "maxTokens": 32000, "input": ["text"] },
          { "id": "north-mini-code-free", "name": "North Mini Code Free", "contextWindow": 200000, "maxTokens": 32000, "input": ["text"] },
          { "id": "nemotron-3-ultra-free", "name": "Nemotron 3 Ultra Free", "contextWindow": 200000, "maxTokens": 32000, "input": ["text"] },
          { "id": "big-pickle", "name": "Big Pickle", "contextWindow": 200000, "maxTokens": 32000, "input": ["text"] },
          { "id": "hy3-free", "name": "HY3 Free", "contextWindow": 256000, "maxTokens": 65536, "input": ["text"] }
        ]
      },
      "opencode-go": {
        "apiKey": "${OPENCODE_GO_API_KEY}",
        "baseUrl": "https://opencode.ai/zen/go/v1",
        "models": [
          { "id": "deepseek-v4-flash", "name": "DeepSeek V4 Flash", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "deepseek-v4-pro", "name": "DeepSeek V4 Pro", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "glm-5.2", "name": "GLM 5.2", "contextWindow": 200000, "maxTokens": 32768, "input": ["text"] },
          { "id": "glm-5.1", "name": "GLM 5.1", "contextWindow": 200000, "maxTokens": 32768, "input": ["text"] },
          { "id": "kimi-k2.7-code", "name": "Kimi K2.7 Code", "contextWindow": 200000, "maxTokens": 65536, "input": ["text"] },
          { "id": "kimi-k2.6", "name": "Kimi K2.6", "contextWindow": 200000, "maxTokens": 65536, "input": ["text"] },
          { "id": "mimo-v2.5", "name": "MiMo V2.5", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text", "image"] },
          { "id": "mimo-v2.5-pro", "name": "MiMo V2.5 Pro", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "mimo-v2-omni", "name": "MiMo V2 Omni", "contextWindow": 256000, "maxTokens": 65536, "input": ["text", "image"] },
          { "id": "mimo-v2-pro", "name": "MiMo V2 Pro", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "minimax-m3", "name": "MiniMax M3", "contextWindow": 200000, "maxTokens": 32768, "input": ["text"] },
          { "id": "minimax-m2.7", "name": "MiniMax M2.7", "contextWindow": 200000, "maxTokens": 32768, "input": ["text"] },
          { "id": "qwen3.7-max", "name": "Qwen3.7 Max", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text"] },
          { "id": "qwen3.7-plus", "name": "Qwen3.7 Plus", "contextWindow": 1000000, "maxTokens": 128000, "input": ["text", "image"] },
          { "id": "qwen3.6-plus", "name": "Qwen3.6 Plus", "contextWindow": 256000, "maxTokens": 65536, "input": ["text", "image"] },
          { "id": "qwen3.5-plus", "name": "Qwen3.5 Plus", "contextWindow": 256000, "maxTokens": 65536, "input": ["text", "image"] },
          { "id": "hy3-preview", "name": "HY3 Preview", "contextWindow": 256000, "maxTokens": 65536, "input": ["text"] }
        ]
      }
    }
  },

  // ============================================================
  // AUTH PROFILES — Como cada provider autentica
  // ============================================================
  "auth": {
    "profiles": {
      "opencode:default": { "provider": "opencode", "mode": "api_key" },
      "opencode-go:default": { "provider": "opencode-go", "mode": "api_key" },
      "google:default": { "provider": "google", "mode": "api_key" }
    }
  },

  // ============================================================
  // CHANNELS — Canais de mensagem
  // ============================================================
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}"
    },
    "whatsapp": {
      "accounts": {
        "default": {
          "enabled": true,
          "selfChatMode": true,
          "dmPolicy": "allowlist",
          "allowFrom": [
            "${WHATSAPP_OWNER_NUMBER}"
          ],
          "groupAllowFrom": [
            "${WHATSAPP_OWNER_NUMBER}"
          ]
        }
      },
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${WHATSAPP_OWNER_NUMBER}"
      ],
      "groupPolicy": "allowlist",
      "groups": {
        // Prompt especial para grupos de ofertas/produtos.
        // Substitua o JID pelo grupo desejado e ajuste o caminho do extrator.
        // "SEU_GRUPO_JID@g.us": {
        //   "requireMention": false,
        //   "systemPrompt": "..."
        // }
      },
      "debounceMs": 0,
      "mediaMaxMb": 50,
      "replyToMode": "first",
      "groupAllowFrom": [
        "${WHATSAPP_OWNER_NUMBER}"
      ]
    }
  },

  // ============================================================
  // PLUGINS — Extensões
  // ============================================================
  "plugins": {
    "entries": {
      "telegram": { "enabled": true },
      "opencode": { "enabled": true },
      "google": {
        "enabled": true,
        "config": {
          "webSearch": { "apiKey": "${GEMINI_API_KEY}" }
        }
      },
      "opencode-go": { "enabled": true },
      "memory-core": {
        "enabled": true,
        "config": {
          "dreaming": {
            "enabled": true,
            "frequency": "0 4 * * *",
            "timezone": "America/Porto_Velho"
          }
        }
      },
      "browser": { "enabled": true },
      "whatsapp": { "enabled": true },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "vaultMode": "bridge",
          "vault": {
            "path": "~/.openclaw/wiki/main",
            "renderMode": "native"
          },
          "bridge": {
            "enabled": true,
            "readMemoryArtifacts": true,
            "indexDreamReports": true,
            "indexDailyNotes": true,
            "indexMemoryRoot": true,
            "followMemoryEvents": true
          },
          "search": {
            "backend": "shared",
            "corpus": "all"
          },
          "render": {
            "preserveHumanBlocks": true,
            "createBacklinks": true,
            "createDashboards": true
          }
        }
      },
      "workboard": { "enabled": true },
      // Google Workspace (Gmail, Calendar, Drive, Tasks, Sheets)
      "openclaw-google-workspace": {
        "enabled": true,
        "config": {
          "credentialsPath": "/home/node/.openclaw/secrets/gmail-credentials.json",
          "tokenPath": "/home/node/.openclaw/secrets/gmail-tokens.json",
          "services": {
            "gmail": { "enabled": true },
            "calendar": { "enabled": true },
            "drive": { "enabled": true, "readOnly": true },
            "contacts": { "enabled": true },
            "tasks": { "enabled": true },
            "sheets": { "enabled": true }
          }
        }
      },
      // SearXNG self-hosted (busca web privada)
      "searxng": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "${SEARXNG_BASE_URL:-http://searxng:8080}"
          }
        }
      }
    },
    "allow": [
      "memory-wiki",
      "workboard",
      "opencode-go",
      "opencode",
      "google",
      "memory-core",
      "browser",
      "telegram",
      "openclaw-google-workspace",
      "searxng"
    ],
    "bundledDiscovery": "compat"
  },

  // ============================================================
  // SKILLS — Habilidades
  // ============================================================
  "skills": {
    "install": {
      "nodeManager": "npm"
    },
    "entries": {
      "clawhub": { "enabled": true },
      "github": {
        "enabled": true,
        "env": {
          "GH_TOKEN": "${GH_TOKEN}"
        }
      },
      "wacli": { "enabled": true },
      // Skills custom deste repo (skills/): habilitadas por padrão
      "home-assistant-rest": { "enabled": true },
      "monitorador-de-servidor": { "enabled": true }
    }
  },

  // ============================================================
  // TOOLS — Ferramentas
  // ============================================================
  "tools": {
    "profile": "coding",
    "media": {
      "audio": {
        "enabled": true,
        "models": [
          {
            "provider": "google",
            "model": "gemini-2.5-flash"
          },
          {
            // Whisper local (instalado na imagem Docker)
            "type": "cli",
            "command": "whisper",
            "args": ["--model", "base", "--output_format", "txt", "{{MediaPath}}"],
            "timeoutSeconds": 120
          }
        ]
      }
    },
    "web": {
      "search": {
        "provider": "searxng",
        "enabled": true
      }
    }
  },

  // ============================================================
  // BROWSER — Automação web (container sem sandbox)
  // ============================================================
  "browser": {
    "noSandbox": true
  },

  // ============================================================
  // COMANDOS / SESSÃO
  // ============================================================
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_OWNER_ID}"
    ]
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 10080
    }
  },

  // ============================================================
  // HOOKS — Ganchos internos
  // ============================================================
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": { "enabled": true },
        "compaction-notifier": { "enabled": true },
        "command-logger": { "enabled": true },
        "bootstrap-extra-files": { "enabled": true },
        "boot-md": { "enabled": true }
      }
    }
  },

  "messages": {
    "visibleReplies": "automatic",
    "groupChat": {
      "visibleReplies": "automatic"
    }
  }
}
